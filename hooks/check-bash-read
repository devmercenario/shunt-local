#!/bin/bash
# Block Bash commands that read large files, redirect to /bulk-reader skill
# Compatible with both Google Antigravity (run_command) and Claude Code (Bash)

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
HOOK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
if [ -f "$HOOK_DIR/../scripts/lib/local-llm.sh" ]; then
  . "$HOOK_DIR/../scripts/lib/local-llm.sh"
fi

# If master switch is OFF or run_command sub-hook is disabled, allow immediately
if ! shunt_hook_is_enabled "run_command"; then
  echo '{"decision": "allow"}'
  exit 0
fi

MIN_LINES="${SHUNT_MIN_LINES:-350}"
case "$MIN_LINES" in ''|*[!0-9]*) MIN_LINES=350 ;; esac

input=$(cat)

# Extract command from Antigravity (toolCall) or Claude Code (tool_input)
command=$(echo "$input" | jq -r '.toolCall.args.CommandLine // .tool_input.command // empty')
[ -z "$command" ] && { echo '{"decision": "allow"}'; exit 0; }

# Detect agent host format
is_antigravity=$(echo "$input" | jq -r 'has("toolCall")')
if [ "$is_antigravity" = "true" ]; then
  block_decision="deny"
else
  block_decision="block"
fi

# Skip piped commands (cat file | grep) — those are targeted reads
echo "$command" | grep -qE '\|' && { echo '{"decision": "allow"}'; exit 0; }

# Skip redirections (cat file > out) — not a read-into-context operation
echo "$command" | grep -qE '>' && { echo '{"decision": "allow"}'; exit 0; }

# Extract file path from read commands, stripping flags (e.g. cat -n, head -100)
file_path=""
if echo "$command" | grep -qE '^(cat|head|tail|less|more|bat|tac|nl|pr) '; then
  cmd_verb=$(echo "$command" | awk '{print $1}')
  args=$(echo "$command" | sed -E 's/^(cat|head|tail|less|more|bat|tac|nl|pr) +//')
  skip_next=false
  for arg in $args; do
    if [ "$skip_next" = "true" ]; then skip_next=false; continue; fi
    case "$arg" in
      -n|-c|--lines|--bytes)
        # Only head/tail take a separate value after -n/-c (e.g. head -n 5 file)
        # For cat, -n is standalone (cat -n file)
        case "$cmd_verb" in head|tail) skip_next=true ;; esac
        continue
        ;;
      -*) continue ;;
      *)  file_path=$(echo "$arg" | tr -d '"'"'"); break ;;
    esac
  done
fi

[ -z "$file_path" ] && { echo '{"decision": "allow"}'; exit 0; }
[ ! -f "$file_path" ] && { echo '{"decision": "allow"}'; exit 0; }

lines=$(wc -l < "$file_path" 2>/dev/null | tr -d ' ' || echo "0")
if [ "$lines" -le "$MIN_LINES" ]; then
  echo '{"decision": "allow"}'
  exit 0
fi

# If local LLM server is offline, fail-open to cloud model
if ! shunt_is_online; then
  echo '{"decision": "allow"}'
  exit 0
fi

echo "{\"decision\": \"${block_decision}\", \"reason\": \"File is ${lines} lines (threshold: ${MIN_LINES}). Use the /bulk-reader skill to delegate this read to your local LLM instead of cat/head/tail.\"}"
