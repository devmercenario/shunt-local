#!/bin/bash
# PreToolUse guard: block Bash/Shell commands that read large files.
# The cross-platform implementation lives in hooks/shunt_guard.py.
DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$(command -v python3 || command -v python || true)"
if [ -n "$PY" ]; then
  exec "$PY" "$DIR/shunt_guard.py" --kind bash "$@"
fi
# Fail-open if no Python interpreter is available (shunt-local requires it).
exit 0
