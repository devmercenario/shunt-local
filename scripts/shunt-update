#!/bin/bash
# Updater for shunt-local: refresh hooks, skills and binaries from the repo.
# Registration lives in scripts/lib/register.sh (shared with install.sh).

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# On Windows Git Bash the ~/.local/bin wrappers may be copies, not symlinks,
# which resolves REPO_DIR to ~/.local. Fall back to the recorded install root
# so updates always target the real snapshot/clone directory.
if [ ! -f "$REPO_DIR/scripts/lib/register.sh" ] && [ -f "${HOME}/.config/shunt-local/install_root" ]; then
  recorded=$(cat "${HOME}/.config/shunt-local/install_root" 2>/dev/null || true)
  if [ -n "$recorded" ] && [ -f "$recorded/scripts/lib/register.sh" ]; then
    REPO_DIR="$recorded"
  fi
fi

# Shared helpers: remote allowlist + signature verification + registration.
# Source from the resolved repository (not the wrapper's own directory), so the
# Windows copy-fallback above still finds them.
# shellcheck source=scripts/lib/update-verify.sh
. "$REPO_DIR/scripts/lib/update-verify.sh"
# shellcheck source=scripts/lib/register.sh
. "$REPO_DIR/scripts/lib/register.sh"

DO_PULL=true
DO_APPLY=false
FETCHED=false
REQUIRE_VERIFY=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-pull) DO_PULL=false; shift ;;
    --pull) DO_PULL=true; shift ;;
    --yes|-y) DO_APPLY=true; shift ;;
    --verify) REQUIRE_VERIFY=true; shift ;;
    -h|--help)
      echo "Usage: shunt-update [--pull | --no-pull] [--yes] [--verify]"
      echo "Updates shunt-local hooks, skills, and binaries from the repository."
      echo ""
      echo "  --yes        Apply fetched upstream changes (default is a dry-run)."
      echo "  --verify     Require a signed commit (or cosign-signed SHA256SUMS) before applying."
      echo "  --no-pull    Skip the remote fetch entirely; re-install from current files."
      exit 0
      ;;
    *) shift ;;
  esac
done

echo "Updating shunt-local..."

if [ "${SHUNT_UPDATE_REQUIRE_SIGNATURE:-}" = "true" ]; then
  REQUIRE_VERIFY=true
fi

# 1. Fetch (supply-chain hardened: trusted host, dry-run by default).
if [ "$DO_PULL" = true ] && [ -d "$REPO_DIR/.git" ]; then
  if git -C "$REPO_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git -C "$REPO_DIR" remote | grep -q 'origin'; then
      remote_url=$(git -C "$REPO_DIR" remote get-url origin 2>/dev/null || echo "")
      if ! shunt_remote_is_trusted "$remote_url"; then
        if [ "${SHUNT_ALLOW_UNTRUSTED_REMOTE:-}" != "true" ]; then
          echo "🔒 Refusing to pull from untrusted remote: ${remote_url:-<none>}" >&2
          echo "   Set SHUNT_ALLOW_UNTRUSTED_REMOTE=true to allow this remote." >&2
          DO_PULL=false
        fi
      fi
    fi
  fi
fi

if [ "$DO_PULL" = true ] && [ -d "$REPO_DIR/.git" ]; then
  if git -C "$REPO_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git -C "$REPO_DIR" remote | grep -q 'origin'; then
      current_branch=$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
      echo "Fetching latest changes from origin/${current_branch}..."
      git -C "$REPO_DIR" fetch origin "$current_branch" && FETCHED=true || echo "Warning: fetch failed; continuing with current repository files."
      if [ "$FETCHED" = "true" ]; then
        if [ "$REQUIRE_VERIFY" = "true" ]; then
          if ! shunt_verify_update "$REPO_DIR" "origin/$current_branch"; then
            echo "🔒 Refusing to apply an unverified update. Re-run without --verify only if you trust the remote." >&2
            exit 1
          fi
        fi
        if [ "$DO_APPLY" = "true" ]; then
          git -C "$REPO_DIR" pull --ff-only origin "$current_branch" || echo "Warning: git pull was not fast-forwarded or local changes exist. Continuing with current repository files."
        else
          echo ""
          echo "ℹ️  Dry run: fetched but did NOT apply changes (pass --yes to apply)."
          echo "    Pending upstream commits:"
          git -C "$REPO_DIR" log --oneline "HEAD..origin/${current_branch}" 2>/dev/null | head -20 || true
          echo "    Re-run 'shunt-update --yes' to apply these updates."
          echo ""
          exit 0
        fi
      fi
    fi
  fi
fi

# 1b. Curl-installed copy (no .git): refresh by re-downloading the snapshot.
if [ "$DO_PULL" = true ] && [ ! -d "$REPO_DIR/.git" ]; then
  if [ "$DO_APPLY" = true ]; then
    echo "Downloading the latest snapshot from the remote repository..."
    if shunt_download_snapshot "$REPO_DIR" main; then
      echo "Applied the latest snapshot."
    else
      echo "⚠️  Download failed; continuing with the current files." >&2
    fi
  else
    echo "ℹ️  Dry run: this copy was installed via curl; pass --yes to download and apply the latest snapshot."
  fi
fi

# 2-6. Binaries, skills, trust and hooks (shared with install.sh).
shunt_link_binaries "$REPO_DIR"
shunt_copy_skills "$REPO_DIR"
shunt_trust_repo "$REPO_DIR"
shunt_register_antigravity_hooks "$REPO_DIR"
shunt_install_opencode_plugin "$REPO_DIR"
shunt_register_cursor_hooks "$REPO_DIR"

# 7. Re-register with Antigravity / Claude Code CLIs if present.
if command -v agy >/dev/null 2>&1; then
  agy plugin install "$REPO_DIR" 2>/dev/null || true
  echo "Re-registered plugin with agy"
fi
if command -v claude >/dev/null 2>&1; then
  claude plugin install "$REPO_DIR" 2>/dev/null || claude plugin add "$REPO_DIR" 2>/dev/null || true
fi

echo ""
echo "shunt-local update complete!"
