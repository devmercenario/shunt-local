#!/bin/bash
# Updater script for shunt-local (Google Antigravity & Claude Code)
# Updates hooks, skills, and binaries from the repository.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

SKILLS_DIR="${HOME}/.agents/skills"
BIN_DIR="${HOME}/.local/bin"
GEMINI_CONFIG_DIR="${HOME}/.gemini/config"
HOOKS_FILE="${GEMINI_CONFIG_DIR}/hooks.json"
TRUSTED_FOLDERS_FILE="${HOME}/.gemini/trustedFolders.json"

DO_PULL=true
DO_APPLY=false
FETCHED=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-pull)
      DO_PULL=false
      shift
      ;;
    --pull)
      DO_PULL=true
      shift
      ;;
    --yes|-y)
      DO_APPLY=true
      shift
      ;;
    -h|--help)
      echo "Usage: shunt-update [--pull | --no-pull] [--yes]"
      echo "Updates shunt-local hooks, skills, and binaries from the repository."
      echo ""
      echo "  --yes        Apply fetched upstream changes (default is a dry-run)."
      echo "  --no-pull    Skip the remote fetch entirely; re-install from current files."
      exit 0
      ;;
    *)
      shift
      ;;
  esac
done

echo "Updating shunt-local..."

# 1. Fetch and pull latest changes from remote repository (supply-chain hardened).
# The remote must be a well-known code host (unless explicitly opted in), and
# fetching is a dry-run by default: changes are only applied with --yes.
if [ "$DO_PULL" = true ] && [ -d "$REPO_DIR/.git" ]; then
  if git -C "$REPO_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git -C "$REPO_DIR" remote | grep -q 'origin'; then
      remote_url=$(git -C "$REPO_DIR" remote get-url origin 2>/dev/null || echo "")
      case "$remote_url" in
        *github.com*|*gitlab.com*|*bitbucket.org*) ;;
        *)
          if [ "${SHUNT_ALLOW_UNTRUSTED_REMOTE:-}" != "true" ]; then
            echo "🔒 Refusing to pull from untrusted remote: ${remote_url:-<none>}" >&2
            echo "   Set SHUNT_ALLOW_UNTRUSTED_REMOTE=true to allow this remote." >&2
            DO_PULL=false
          fi
          ;;
      esac
    fi
  fi
fi

if [ "$DO_PULL" = true ] && [ -d "$REPO_DIR/.git" ]; then
  if git -C "$REPO_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git -C "$REPO_DIR" remote | grep -q 'origin'; then
      current_branch=$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
      echo "Fetching latest changes from origin/${current_branch}..."
      git -C "$REPO_DIR" fetch origin "$current_branch" && FETCHED=true || echo "Warning: fetch failed; continuing with current repository files."
      if [ "$FETCHED" = "true" ]; then
        if [ "$DO_APPLY" = "true" ]; then
          git -C "$REPO_DIR" pull --ff-only origin "$current_branch" || echo "Warning: git pull was not fast-forwarded or local changes exist. Continuing with current repository files."
        else
          echo ""
          echo "ℹ️  Dry run: fetched but did NOT apply changes (pass --yes to apply)."
          echo "    Pending upstream commits:"
          git -C "$REPO_DIR" log --oneline "HEAD..origin/${current_branch}" 2>/dev/null | head -20 || true
          echo "    Re-run 'shunt-update --yes' to apply these updates."
          echo ""
          exit 0
        fi
      fi
    fi
  fi
fi

# 2. Update binaries in ~/.local/bin
mkdir -p "$BIN_DIR"
for bin_script in bulk-read code-write shunt-update shunt-local task-exec; do
  target="$REPO_DIR/scripts/$bin_script"
  if [ -f "$target" ]; then
    chmod +x "$target"
    ln -sf "$target" "$BIN_DIR/$bin_script"
    echo "Linked binary '$bin_script' -> $BIN_DIR/$bin_script"
  fi
done

# 3. Update skills in ~/.agents/skills (copy to keep realpath inside ~/.agents/)
mkdir -p "$SKILLS_DIR"
for skill in "$REPO_DIR"/skills/*; do
  if [ -d "$skill" ]; then
    skill_name="$(basename "$skill")"
    rm -rf "$SKILLS_DIR/$skill_name"
    cp -r "$skill" "$SKILLS_DIR/$skill_name"
    echo "Updated skill '$skill_name' in $SKILLS_DIR/$skill_name"
  fi
done

# 4. Ensure repository is trusted in Antigravity ~/.gemini/trustedFolders.json
if [ -d "${HOME}/.gemini" ] && command -v jq >/dev/null 2>&1; then
  if [ ! -f "$TRUSTED_FOLDERS_FILE" ]; then
    echo "{}" > "$TRUSTED_FOLDERS_FILE"
  fi
  tmp_tf=$(umask 077 && mktemp) || exit 1
  jq --arg dir "$REPO_DIR" '. + {($dir): "TRUST_FOLDER"}' "$TRUSTED_FOLDERS_FILE" > "$tmp_tf" && mv "$tmp_tf" "$TRUSTED_FOLDERS_FILE"
  echo "Ensured $REPO_DIR is trusted in $TRUSTED_FOLDERS_FILE"
fi

# 5. Register/update PreToolUse lifecycle hooks in ~/.gemini/config/hooks.json
if [ -d "$GEMINI_CONFIG_DIR" ] || command -v agy >/dev/null 2>&1; then
  mkdir -p "$GEMINI_CONFIG_DIR"
  if [ ! -f "$HOOKS_FILE" ]; then
    echo "{}" > "$HOOKS_FILE"
  fi

  tmp_hooks=$(umask 077 && mktemp) || exit 1
  jq \
    --arg size_hook "$REPO_DIR/hooks/check-file-size" \
    --arg bash_hook "$REPO_DIR/hooks/check-bash-read" \
    '. + {
      "shunt-local": {
        "PreToolUse": [
          {
            "matcher": "view_file",
            "hooks": [
              {
                "type": "command",
                "command": $size_hook
              }
            ]
          },
          {
            "matcher": "run_command",
            "hooks": [
              {
                "type": "command",
                "command": $bash_hook
              }
            ]
          }
        ]
      }
    }' "$HOOKS_FILE" > "$tmp_hooks" && mv "$tmp_hooks" "$HOOKS_FILE"
  echo "Updated PreToolUse hooks in $HOOKS_FILE"
fi

# 6. Re-register with Antigravity CLI (agy) if present
if command -v agy >/dev/null 2>&1; then
  agy plugin install "$REPO_DIR" 2>/dev/null || true
  echo "Re-registered plugin with agy"
fi

# 7. Update OpenCode plugin if present
OPENCODE_CONFIG_DIR="${HOME}/.config/opencode"
OPENCODE_PLUGINS_DIR="${OPENCODE_CONFIG_DIR}/plugins"
if [ -d "$OPENCODE_CONFIG_DIR" ] || command -v opencode >/dev/null 2>&1; then
  mkdir -p "$OPENCODE_PLUGINS_DIR"
  chmod 700 "$OPENCODE_PLUGINS_DIR" 2>/dev/null || true
  cp "$REPO_DIR/plugins/opencode/shunt-local.ts" "$OPENCODE_PLUGINS_DIR/shunt-local.ts"
  chmod 600 "$OPENCODE_PLUGINS_DIR/shunt-local.ts" 2>/dev/null || true
  echo "Updated OpenCode native plugin in $OPENCODE_PLUGINS_DIR/shunt-local.ts"
fi

echo ""
echo "shunt-local update complete!"
