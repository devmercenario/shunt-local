#!/bin/bash
# Delegate boilerplate code generation to local LLM code-writer mode
# Usage: code-write --spec "write tests for UserService" --reference ref.test.ts --target out.test.ts

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
. "$SCRIPT_DIR/lib/local-llm.sh"

MODE_NAME="code-writer"

spec=""
reference=""
target=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --spec)      spec="$2"; shift 2 ;;
    --reference) reference="$2"; shift 2 ;;
    --target)    target="$2"; shift 2 ;;
    *)           shift ;;
  esac
done

if [ -z "$spec" ]; then
  echo "Error: --spec is required" >&2
  exit 1
fi

if [ -z "$reference" ]; then
  echo "Error: --reference is required — pass a file whose patterns the output should match." >&2
  echo "For a follow-up, reference the file the previous call just generated." >&2
  exit 1
fi

if [ ! -f "$reference" ]; then
  echo "Error: reference file not found: $reference" >&2
  exit 1
fi

shunt_preflight || exit 1
shunt_tmpfile message_file || exit 1
shunt_tmpfile answer_file || exit 1

printf 'Spec: %s\n\nReference:\n' "$spec" > "$message_file"
cat -- "$reference" >> "$message_file"

shunt_invoke "$MODE_NAME" "$message_file" > "$answer_file" || exit 1

clean=$(sed '/^```/d' "$answer_file")

if [ -n "$target" ]; then
  # Security: validate target path is within current working directory
  real_target=$(cd "$(dirname "$target")" 2>/dev/null && pwd || echo "")/$(basename "$target")
  real_cwd=$(pwd -P)
  case "$real_target" in
    "$real_cwd"/*)  ;; # Within CWD — safe
    "$real_cwd")    ;; # Is CWD itself — safe
    *)
      echo "Error: target path '$target' resolves outside the working directory." >&2
      echo "  Resolved: $real_target" >&2
      echo "  CWD:      $real_cwd" >&2
      exit 1
      ;;
  esac
  target_dir=$(dirname "$target")
  [ -n "$target_dir" ] && mkdir -p "$target_dir"
  printf '%s\n' "$clean" > "$target"
  echo "Wrote $(wc -l < "$target" | tr -d ' ') lines to $target" >&2
else
  printf '%s\n' "$clean"
fi

echo "[shunt-local: delegated to $SHUNT_MODEL]" >&2
