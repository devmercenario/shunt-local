#!/bin/bash
# Delegate boilerplate code generation to local LLM code-writer mode
# Usage: code-write --spec "write tests for UserService" --reference ref.test.ts --target out.test.ts

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
. "$SCRIPT_DIR/lib/local-llm.sh"

MODE_NAME="code-writer"

spec=""
reference=""
target=""
dry_run=false
assume_yes=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --spec)      spec="$2"; shift 2 ;;
    --reference) reference="$2"; shift 2 ;;
    --target)    target="$2"; shift 2 ;;
    --dry-run)   dry_run=true; shift ;;
    --yes|-y)    assume_yes=true; shift ;;
    *)           shift ;;
  esac
done

if [ -z "$spec" ]; then
  echo "Error: --spec is required" >&2
  exit 1
fi

if [ -z "$reference" ]; then
  echo "Error: --reference is required — pass a file whose patterns the output should match." >&2
  echo "For a follow-up, reference the file the previous call just generated." >&2
  exit 1
fi

if [ ! -f "$reference" ]; then
  echo "Error: reference file not found: $reference" >&2
  exit 1
fi
if ! shunt_read_allowed "$reference"; then
  echo "Error: refusing to read reference '$reference' outside the working directory." >&2
  echo "  Set SHUNT_ALLOW_READS_OUTSIDE_CWD=true to allow this." >&2
  exit 1
fi

shunt_preflight || exit 1
shunt_tmpfile message_file || exit 1
shunt_tmpfile answer_file || exit 1

printf 'Spec: %s\n\nReference:\n' "$spec" > "$message_file"
cat -- "$reference" >> "$message_file"

shunt_invoke "$MODE_NAME" "$message_file" > "$answer_file" || exit 1

clean=$(sed '/^```/d' "$answer_file")

if [ -n "$target" ]; then
  # Never write without explicit approval: --dry-run prints the result, and a
  # non-interactive caller must pass --yes (or set SHUNT_ASSUME_YES=true).
  if [ "$dry_run" = "true" ]; then
    printf '%s\n' "$clean"
    echo "[shunt-local: dry-run; no file written]" >&2
    exit 0
  fi
  if [ "$assume_yes" != "true" ] && [ "${SHUNT_ASSUME_YES:-}" != "true" ]; then
    if [ ! -t 0 ]; then
      printf '%s\n' "$clean"
      echo "[shunt-local: refused to write '$target' without confirmation; re-run with --yes after the user approves]" >&2
      exit 0
    fi
    printf 'Write %s? [y/N] ' "$target" >&2
    read -r _answer || _answer=""
    case "$_answer" in
      y|Y|yes|YES) ;;
      *) echo "[shunt-local: write aborted]" >&2; exit 0 ;;
    esac
  fi
  # Security: resolve the parent directory physically (so symlinked dirs cannot
  # escape the working directory) and refuse to write through a symlink target.
  real_cwd=$(pwd -P)
  real_target=$(cd "$(dirname "$target")" 2>/dev/null && pwd -P || echo "")/$(basename "$target")
  case "$real_target" in
    "$real_cwd"/*)  ;; # Within CWD — safe
    "$real_cwd")    ;; # Is CWD itself — safe
    *)
      echo "Error: target path '$target' resolves outside the working directory." >&2
      echo "  Resolved: $real_target" >&2
      echo "  CWD:      $real_cwd" >&2
      exit 1
      ;;
  esac
  if [ -L "$target" ]; then
    echo "Error: target path '$target' is a symlink; refusing to write through it." >&2
    exit 1
  fi

  # Refuse home dotfiles (mirrors task-exec) and sensitive project files
  # (VCS/CI/lockfiles/credential files) unless explicitly opted in.
  if [ -n "${HOME:-}" ]; then
    case "$real_target" in
      "$HOME"/.*)
        echo "Error: refusing to write to a home dotfile: $real_target" >&2
        exit 1
        ;;
    esac
  fi
  if [ "${SHUNT_ALLOW_SENSITIVE_WRITES:-}" != "true" ]; then
    target_base=$(basename "$real_target")
    case "$target_base" in
      .env|.env.*|.npmrc|.pypirc|.netrc|.gitmodules|.gitattributes|.bashrc|.profile|.zshrc|\
      package.json|package-lock.json|npm-shrinkwrap.json|yarn.lock|pnpm-lock.yaml|\
      Makefile|makefile|GNUmakefile|Dockerfile|docker-compose.yml|docker-compose.yaml|\
      Gemfile|Gemfile.lock|Cargo.toml|Cargo.lock|go.mod|go.sum|pyproject.toml|\
      setup.py|setup.cfg|pytest.ini|tox.ini|requirements.txt|poetry.lock|shunt.config.json)
        echo "Error: refusing to overwrite sensitive file '$real_target'." >&2
        echo "  Set SHUNT_ALLOW_SENSITIVE_WRITES=true to allow this." >&2
        exit 1
        ;;
    esac
    case "/$real_target/" in
      */.git/*|*/.github/*|*/.gitlab/*|*/.circleci/*|*/.husky/*|*/.githooks/*)
        echo "Error: refusing to write inside a VCS/CI directory: $real_target" >&2
        echo "  Set SHUNT_ALLOW_SENSITIVE_WRITES=true to allow this." >&2
        exit 1
        ;;
    esac
  fi

  target_dir=$(dirname "$target")
  [ -n "$target_dir" ] && mkdir -p "$target_dir"
  # Write to a sibling temp file then rename: replaces the directory entry and
  # cannot be redirected through a symlink created between the checks and the write.
  tmp_out="${target}.shunt-tmp.$$"
  printf '%s\n' "$clean" > "$tmp_out"
  mv -f "$tmp_out" "$target"
  shunt_audit code-write status=written target="$target" reference="$reference"
  echo "Wrote $(wc -l < "$target" | tr -d ' ') lines to $target" >&2
else
  printf '%s\n' "$clean"
fi

echo "[shunt-local: delegated to $SHUNT_MODEL]" >&2
